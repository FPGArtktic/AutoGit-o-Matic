# AutoGit-o-Matic - Example Configuration File
# Copy this file as autogit-o-matic.ini and customize it to your needs

[SETTINGS]
# Log format. Available options: TXT, JSON
log_format = TXT

# Exit 2 when at least one repository fails. This becomes the default
# in 3.0.0; opting in now silences the warning about that change.
# exit_on_failure = yes

# [DEFAULTS]
# Values every repository in the run inherits.
# exclude   - comma-separated globs; a matching repository is skipped
# max_depth - how far below a configured path to look (0 = the path, 1 = default)
# ssh_key   - becomes GIT_SSH_COMMAND for that repository's git calls
# timeout   - seconds one git call may take (default 300)
# A repository can override ssh_key and timeout for itself with
# 'git config autogit.ssh-key ...' and 'git config autogit.timeout ...'.
# mirror_dir - where [MIRROR] keeps its mirrors (that section needs it)
# fsck        - yes runs git fsck --connectivity-only after a mirror update
# verify_tags - yes verifies the signed tags of a mirror after an update
# exclude = */vendor,*-archive
# max_depth = 2
# ssh_key = /home/user/.ssh/deploy
# timeout = 120
# mirror_dir = /srv/mirrors
# fsck = yes
# verify_tags = yes

[PULL]
# Paths to repositories you want to update using 'git pull'
# You can provide a direct path to a repository
/home/user/git/repository1/

# You can also provide a parent directory containing multiple repositories
# The script will automatically detect all Git repositories in this directory
/home/user/git/projects/

# Alternative syntax using 'path =' is also possible
path = /home/user/git/important-project/

[FETCH]
# Paths to repositories you want to update using 'git fetch'
# 'fetch' downloads changes but doesn't merge them automatically, which is safer
# for repositories you're actively working on
/home/user/git/working-repository/

# As with the [PULL] section, you can specify a parent directory
/home/user/git/repositories-to-monitor/

# Comments start with '#' or ';'
; path = /home/user/git/another-project/

[SILENT_UPDATE]
# Paths to repositories you want kept current without touching their
# work trees. The script fetches, then fast-forwards every branch that
# tracks a remote, is behind it, and is not checked out anywhere - in
# the repository itself or in any of its worktrees. Nothing is merged,
# so this is the safe choice for clones somebody is working in.
# /home/user/git/clone-i-work-in/

# [MIRROR]
# Sources to mirror into mirror_dir, for carrying to a machine with no
# network. The first run clones with --mirror, later runs update and
# prune. Submodules named in .gitmodules are mirrored too, and a
# relative URL like ../shared.git resolves against its source.
# https://github.com/example/project.git
# /srv/git/internal.git

# [EXAMPLE OF ANOTHER SECTION]
# Future versions may support additional sections
# for other Git operations such as status, push, etc.